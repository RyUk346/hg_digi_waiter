# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://hyperglow:hyperglow_dev@localhost:5432/hyperglow

# ─── Auth.js ──────────────────────────────────────────────────────────────
# Generate a real secret: `openssl rand -base64 32`
AUTH_SECRET=replace-me-with-a-random-32-char-string
AUTH_URL=http://localhost:3000

# ─── Google OAuth (optional) ──────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <AUTH_URL>/api/auth/callback/google
# Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (for password reset + welcome emails) ──────────────────────────
# Gmail SMTP works out of the box. Setup:
#   1. Enable 2FA on the Gmail account
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail / Other (HyperGlow Admin)"
#   4. Paste the 16-character password as SMTP_PASS below
# Leave SMTP_USER/SMTP_PASS blank to log emails to the console (dev only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_NAME=HyperGlow Admin

# ─── Sub-path deployment ──────────────────────────────────────────────────
# Leave UNSET for local dev (serves at /).
# On the VPS where the app lives under a path, set this:
#   NEXT_PUBLIC_BASE_PATH=/SoftPOS/Test
NEXT_PUBLIC_BASE_PATH=

# ─── Realtime bridge (apps/realtime) ──────────────────────────────────────
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# ─── Device API (for the standalone /kds kitchen display) ─────────────────
NEXT_PUBLIC_DEVICE_API_URL=http://localhost:3020
