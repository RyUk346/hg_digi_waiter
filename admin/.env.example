# Copy to .env for the db package and apps/web/.env.local for the app
# Postgres connection (matches docker-compose defaults)
DATABASE_URL=postgres://hyperglow:hyperglow_dev@localhost:5432/hyperglow

# Auth.js — generate with `openssl rand -base64 32` (or `npx auth secret`)
AUTH_SECRET=replace-me-with-a-random-32-char-string
AUTH_URL=http://localhost:3000

# Seed admin user (used by `pnpm db:seed`)
SEED_ADMIN_EMAIL=anton@tavola.test
SEED_ADMIN_PASSWORD=tavola
SEED_ADMIN_NAME=Anton Joseph
